import cv2
import numpy as np
from google.colab.patches import cv2_imshow

# Read the image (using the same image path as before)
img_path = '/content/134253236052803564.jpg'
img = cv2.imread(img_path)

# Check if image was loaded
if img is None:
    print(f"Error: Could not load image from {img_path}")
else:
    # It's often beneficial to convert to grayscale or binary for morphological operations
    # For demonstration, we'll convert to grayscale, and then to binary if needed
    gray_img = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # For better visualization of erosion, we'll apply it on a binary image
    # Apply a binary threshold to the grayscale image
    _, binary_img = cv2.threshold(gray_img, 127, 255, cv2.THRESH_BINARY)

    # Define a kernel (structuring element) for erosion
    # A 5x5 rectangular kernel is common
    kernel = np.ones((5, 5), np.uint8)

    # Apply erosion
    # The 'iterations' parameter controls how many times erosion is applied
    eroded_img = cv2.erode(binary_img, kernel, iterations=1)

    # Display the original binary and the eroded images
    print("Original Binary Image:")
    cv2_imshow(binary_img)
    print("Eroded Image:")
    cv2_imshow(eroded_img)
